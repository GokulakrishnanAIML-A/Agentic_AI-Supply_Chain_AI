# ==============================================================================
# SupplyChainAI - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- LLM Engine Configuration ---
# Options: mock | gemini | openai | ollama
LLM_PROVIDER=mock
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- RAG & Vector Embeddings ---
# Options: mock | local | gemini
# 'local' uses sentence-transformers/all-mpnet-base-v2 (768-dim) without API keys
EMBEDDING_PROVIDER=mock
EMBEDDING_DIM=768

# --- Database & PostgreSQL Configuration ---
POSTGRES_USER=supplychain
POSTGRES_PASSWORD=supplychain
POSTGRES_DB=supplychain
POSTGRES_HOST=localhost
# Use 5433 when a local Postgres service already occupies 5432
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://supplychain:supplychain@localhost:5433/supplychain

# --- API & Web Server ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# --- Mathematical Optimization Engine (MILP) ---
SOLVER_BACKEND=ortools
RISK_PENALTY_WEIGHT=1.25
MAX_REPLAN=2

# --- Governance & HITL Reviewer Keys ---
# Format: username:api_key,username2:api_key2
PLANNER_KEYS=alice:key_alice,bob:key_bob,lead_planner:secret_key_123
